NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/vnuc
MONGODB_DB=vnuc
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="VNUC <your-gmail-address@gmail.com>"
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Server-side AWS configuration. Never prefix credentials with NEXT_PUBLIC_.
AWS_REGION=ap-south-1

S3_IMAGE_BUCKET=vnc-bucket

# Optional: CloudFront or another public base URL for objects in S3_IMAGE_BUCKET.
S3_PUBLIC_BASE_URL=https://dxsj9q57zbwmk.cloudfront.net

